[Unit]
Description=Tracker — painel de To-Do + notificações nativas (daemon)
After=graphical-session.target
# Sem teto de tentativas, um erro de boot vira ruído eterno: em 2026-10-27 o
# schema do Notion divergiu e o daemon reiniciou 623 vezes em 8 dias sem que
# nada avisasse. Com burst, o systemd desiste e entra em `failed` — estado que
# aparece em `systemctl --failed` e que é o único gatilho do OnFailure=.
# 12 tentativas ≈ 1 min de indisponibilidade antes de desistir; um crash
# transitório (OOM, rede) ainda é absorvido.
StartLimitIntervalSec=300
StartLimitBurst=12
# Alerta no desktop quando o systemd desiste de reiniciar. Fica no unit, e não
# no código do app, porque o daemon morre durante o boot — um initializer que
# levanta (foi o SchemaError de 2026-10-27) mata o processo antes de qualquer
# job rodar, então um alerta em Ruby nunca seria alcançado.
# `OnFailure=` aceita só nome de unit (um caminho é descartado em silêncio), daí
# a unit-template tracker-alert@. `%n` (COM o sufixo .service) e não `%N`: o
# systemd exige que a instância de uma template seja um nome de unit completo —
# `tracker-alert@tracker` é descartado como argumento inválido, enquanto
# `tracker-alert@tracker.service` resolve.
OnFailure=tracker-alert@%n

[Service]
Type=simple
WorkingDirectory=%h/Repositories/tracker
ExecStart=%h/Repositories/tracker/bin/tracker
# production: sem reloader/file-watcher, eager load (o daemon não edita código
# em runtime). bin/tracker exporta RAILS_ENV=production por conta própria.
Environment=RAILS_ENV=production
Restart=on-failure
RestartSec=5s
SyslogIdentifier=tracker
# Log vai para o journal (production.rb: logger em STDOUT, level info).
StandardOutput=journal
StandardError=journal
# Teto de memória: o pico já chegou a 22,7G (OOM killer do kernel, 2026-10-20).
# Com o limite, estourar mata só o daemon — o systemd reinicia — em vez de
# arriscar a sessão inteira. O ciclo normal usa ~100 MB; a varredura larga
# diária do Jira chega a ~600 MB.
MemoryMax=2G

[Install]
WantedBy=default.target
