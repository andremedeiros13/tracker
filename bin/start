#!/usr/bin/env sh
# Inicia o Tracker (spec §4 + ADR 0001): o `rails server` serve só o health
# check (/up) e roda o scheduler de notificações nativas (thread em
# config/initializers/scheduler.rb). A UI é o Notion.
# systemd user unit roda com PATH mínimo — sem o ruby do asdf, o bundler do
# sistema (ruby 3.3) não encontra as gems do projeto. Aponta direto pro
# install do asdf (lê .tool-versions; os shims precisariam do asdf no PATH).
if [ -d "$HOME/.asdf/installs/ruby" ]; then
  RUBY_INSTALL="$HOME/.asdf/installs/ruby/$(cat "$HOME/.tool-versions" 2>/dev/null | awk '$1=="ruby" {print $2}')"
  if [ -x "$RUBY_INSTALL/bin/ruby" ]; then
    PATH="$RUBY_INSTALL/bin:$PATH"
  fi
fi

set -a
[ -f .env ] && . ./.env
set +a
exec ./bin/rails server "$@"
