# Notion — token da integration, database To-Dos e pages Brag document / 1-on-1
# IDs: abra o item no Notion → ••• → Copy link → o UUID no fim da URL
TRACER_NOTION_TOKEN=ntn_xxx
TRACER_NOTION_DATABASE_ID=xxx
TRACER_NOTION_BRAG_PAGE_ID=xxx
TRACER_NOTION_ONE_ON_ONES_PAGE_ID=xxx
# seu nome nas transcrições (matching parcial — "André Medeiros" casa "André")
TRACER_ONE_ON_ONES_ME="Seu Nome"

# Tracking — entregas do dia (Jira + GitHub)
# accountId: https://SEU-JIRA/rest/api/3/myself (campo accountId)
JIRA_EMAIL=me@example.com
JIRA_API_TOKEN=xxx
JIRA_SITE=https://sua-empresa.atlassian.net
JIRA_ACCOUNT_ID=xxx
GITHUB_ORG=SuaOrg

# Opcionais — sem elas os defaults do código valem
# intervalo de notificação em minutos, janela ativa do dia (default 45 / 09:00–18:00)
#TRACER_NOTIFY_INTERVAL_MINUTES=45
#TRACER_NOTIFY_ACTIVE_START=09:00
#TRACER_NOTIFY_ACTIVE_END=18:00
# Tracking (Brag document): cadência e janela do rebuild do dia (default 30 / 08:00–23:50)
#TRACER_TRACKING_INTERVAL_MINUTES=30
#TRACER_TRACKING_ACTIVE_START=08:00
#TRACER_TRACKING_ACTIVE_END=23:50
# hora da varredura larga diária do Jira (default 23:40) — roda 1x/dia, ~60s
#TRACER_JIRA_SWEEP_AT=23:40
# filtro do Jira no ciclo: "estreito" (só cards com sua participação, ~0,5s) ou
# "largo" (tudo que mudou em 2 dias, ~60s e ~600MB). O largo roda 1x/dia de qualquer forma.
#TRACER_JIRA_FILTRO=estreito
#TRACER_ONE_ON_ONES_INTERVAL_MINUTES=45
#TRACER_DRY_RUN=1   # não escreve no Notion; loga o que escreveria
#TRACER_LOG_LEVEL=info
# seu login no GitHub (sem ele, o daemon descobre via API)
#GITHUB_USERNAME=seu-usuario
# rastreio do campo Reviewer no Jira (descubra o id: rake tracking:discover_reviewer).
# Cuidado: o discovery casa também "QA Reviewer", que é outro campo — escolha o
# que tem o nome exato "Reviewer" no changelog.
#JIRA_REVIEWER_FIELD_ID=customfield_10125
# sem GITHUB_TOKEN, o token do gh CLI é usado
#GITHUB_TOKEN=ghp_xxx
# pasta de transcrições (default: one_on_ones/ na raiz do repo, já vem com o projeto)
#TRACER_ONE_ON_ONES_DIR=/home/voce/Downloads/one-on-ones
